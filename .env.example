# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API). Both are safe to expose to
# the browser (that's what NEXT_PUBLIC_ means) as long as Row Level Security
# is enabled on every table — see supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
